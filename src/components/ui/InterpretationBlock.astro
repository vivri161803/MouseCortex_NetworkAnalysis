---
export interface Props {
  title?: string;
}

const { title } = Astro.props;
---
<div class="my-6 rounded-xl border-l-[3px] border-apple-accent bg-apple-accent/[0.03] p-5">
  <h4 class="text-sm font-semibold text-apple-text tracking-tight mb-2">
    {title || 'Interpretation'}
  </h4>
  <div class="text-xs text-apple-text-muted leading-relaxed space-y-2">
    <slot />
  </div>
</div>
